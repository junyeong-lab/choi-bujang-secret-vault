{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ops",
      "destination": "/api/ai?__ops=step12"
    },
    {
      "source": "/api/restore",
      "destination": "/api/restore/memo"
    }
  ]
}
